APP_NAME='Retail POS'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost


APP_INSTALLED=false

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=off_pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LP=CC
IS_DEMO=false
IS=false
EC=false
RE=false

ECOMMERCE_COMPANY_ID=0

# Print Manager / QZ Tray (official signing workflow — see storage/app/qz/README.md)
PRINT_ENV=development
PRINT_DEFAULT_METHOD=qz_tray
PRINT_LOG_ENABLED=true

# Paths to PEM files (defaults: storage/app/qz/digital-certificate.txt and private-key.pem)
QZ_CERTIFICATE_PATH=
QZ_PRIVATE_KEY_PATH=
QZ_SIGNATURE_ALGORITHM=SHA512
QZ_TRAY_HOST=localhost
QZ_TRAY_WEBSOCKET_PORT=8181
QZ_TRAY_SECURE_WEBSOCKET_PORT=8182
QZ_TRAY_RECONNECT_INTERVAL_MS=3000
QZ_TRAY_CONNECTION_TIMEOUT_MS=10000
QZ_TRAY_INVOICE_FOOTER="Thank you for shopping with us!"

# ZKTeco (PHP sockets extension required; server must reach device — UDP port 4370 by default)
# ZKTECO_HOST=192.168.1.201
# ZKTECO_PORT=4370
# ZKTECO_ATTENDANCE_LIMIT=500
